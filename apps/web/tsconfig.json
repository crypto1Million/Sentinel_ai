{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",

    "paths": {
      "@/*": ["./*"]
    },

    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,

    "plugins": [
      {
        "name": "next"
      }
    ]
  }
}